# Copy to .env for local development (start.bat creates one automatically).
# On Railway, set these as service variables instead.

# PostgreSQL connection string. Locally, start.bat runs a bundled Postgres at this URL.
# On Railway, reference the Postgres plugin: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://grimoire:grimoire_local@localhost:5433/grimoire

# Better Auth: a long random string (e.g. `openssl rand -hex 32`). Keep it secret.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# The public URL people use to reach the site.
# Local: http://localhost:5173   Railway: https://your-app.up.railway.app
BETTER_AUTH_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

PORT=3001

# Steam Web API key for game artwork and patch notes (https://steamcommunity.com/dev/apikey).
# Server-side only. Never commit a real key.
STEAM_API_KEY=
# How often (minutes) to check Steam for new patch notes.
# STEAM_NEWS_INTERVAL_MIN=30
# Prices and DLC come from the public Steam store API (no key). How often (hours) to re-check prices,
# and which store region's prices/currency to show.
# STEAM_STORE_INTERVAL_HOURS=3
# STEAM_COUNTRY=us

# Admin API key: lets the add-vgame / add-bgame / add-cgame scripts add and update games (POST /api/admin/games).
# At least 32 characters, e.g. `openssl rand -hex 32`. start.bat generates one locally.
# Leave it empty in production to allow only signed-in admins (npm run make-admin).
ADMIN_API_KEY=

# Optional: BoardGameGeek API token (register at https://boardgamegeek.com/applications). The add-bgame /
# add-cgame scripts use it to look games up, and the server uses it to sync expansions for games with a bgg_id.
# BGG_API_TOKEN=
# How often (hours) to re-check BoardGameGeek for new expansions.
# BGG_SYNC_INTERVAL_HOURS=24

# Where uploaded thumbnails and rulebooks are kept (default: .localuploads in the repo).
# On Railway, add a Volume mounted at /data and set this to /data/uploads, or files vanish on every deploy.
# UPLOADS_DIR=/data/uploads

# Optional: Claude API key (https://console.anthropic.com). Only the add-bgame / add-cgame scripts use it,
# on your computer, to write a game's TLDR and details from its PDF rulebook. Never set this on Railway.
# ANTHROPIC_API_KEY=

# Set to true only if your Postgres requires SSL (Railway's private network does not).
# PGSSL=true
